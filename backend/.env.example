# NASA Earthdata — register at https://urs.earthdata.nasa.gov
# IMPORTANT: after registering, you must also authorize the
# "LP DAAC Data Pool" application under your Earthdata profile's
# Applications tab, or MODIS downloads will 401 even with valid
# credentials.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=

# NASA FIRMS (fire data) — register at https://firms.modaps.eosdis.nasa.gov
NASA_FIRMS_KEY=

# Conda environment path (Windows only — see Environment Setup
# section in TEAMMATE_HANDOFF.md for why this is needed)
RAPHAEL_CONDA_PREFIX=C:\path\to\your\anaconda3\envs\raphael-env
